#!/bin/sh
#
# Pre-commit gate: keep the generated SIDM2 worklist table in step with the data
# it is generated from.
#
# WHY THIS IS A HOOK AND NOT CI. `.github/workflows/ci.yml` runs on a fresh
# ubuntu checkout, and `data/composers/*.json` is gitignored -- the generator
# reads those to count files per player, so the check simply cannot run there.
# It has to run somewhere the fetched data exists, which means locally.
#
# WHY IT EXISTS AT ALL. The table this guards was hand-written and rotted
# completely: it listed six players as "tackle next" long after all six had
# reached `verified`. gen-coverage.js's header has said "run --check from a
# pre-commit gate so it cannot rot again" since it was written, and until now
# nothing did.
#
# Bypass with `git commit --no-verify` when you genuinely need to (e.g. an
# in-progress commit you will fix up before pushing).
#
# Installed by `npm run hooks:install`, and automatically by `npm install`
# (package.json's `prepare` script) -- both just point core.hooksPath here.
# To add another gate, append it to the same pattern below; the obvious
# candidate is `node scripts/dev/gen-coverage.js --check` for COVERAGE.md.

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Only pay the cost when something the table is derived from actually changed.
if ! printf '%s\n' "$staged" | grep -qE '^(knowledge/players/.*\.md|knowledge/sidm2-ports\.json|docs/SIDM2-INTEGRATION\.md|scripts/dev/gen-sidm2-worklist\.js)$'; then
  exit 0
fi

# A fresh clone has no fetched composer data. Blocking every card edit until
# someone runs a network fetch would be a gate that teaches people to pass
# --no-verify reflexively, which is worse than no gate.
if [ ! -d data/composers ]; then
  echo "pre-commit: skipping SIDM2 worklist check -- data/composers/ is absent." >&2
  echo "            run 'npm run fetch:composers' if you want this gate active." >&2
  exit 0
fi

if ! node scripts/dev/gen-sidm2-worklist.js --check; then
  echo "" >&2
  echo "pre-commit: the SIDM2 worklist table in docs/SIDM2-INTEGRATION.md is stale." >&2
  echo "            Regenerate and stage it:" >&2
  echo "" >&2
  echo "              npm run knowledge:worklist" >&2
  echo "              git add docs/SIDM2-INTEGRATION.md" >&2
  echo "" >&2
  exit 1
fi

exit 0
